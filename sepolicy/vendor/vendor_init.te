set_prop(vendor_init, vendor_alarm_boot_prop)
set_prop(vendor_init, vendor_camera_prop)
set_prop(vendor_init, vendor_camera_remapid_prop)
set_prop(vendor_init, vendor_video_prop)
set_prop(vendor_init, vendor_fingerprint_prop)

allow vendor_init {
  proc_dirty
  proc
}:file w_file_perms;

allow vendor_init input_device:chr_file { create setattr unlink rw_file_perms };

# Allow init.qcom.usb.sh to create files in uvc.0
allow vendor_qti_init_shell configfs:dir create_dir_perms;
allow vendor_qti_init_shell configfs:{
  file
  lnk_file
} create_file_perms;
